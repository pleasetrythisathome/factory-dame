      dct:source narr:Sample_FactoryDameMonetization_20260519 ;
      skos:note "Default monetization posture for factory-dame is open-source / community-first. The engine, voice primitives, and the nd-* CLIs ship under a permissive license. Recorded as a notion, not a decision." .

    narr:Claim_CommercialPathContingent a narr:Claim ;
      narr:aboutNode narr:Narrative_FactoryDameOpenSourceDefault ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      narr:supports narr:Narrative_FactoryDameOpenSourceDefault ;
